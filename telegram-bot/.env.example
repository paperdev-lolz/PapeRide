# PapeRide Telegram Bot Configuration
# Copy this file to .env and fill in your own values.

BOT_USERNAME=your_bot_username          # without @, from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrs # from @BotFather

# PapeRide Website (shared TBRide backend) — the single source of truth.
# WEBSITE_INTERNAL_TOKEN must equal TELEGRAM_INTERNAL_TOKEN in Website/.env
WEBSITE_URL=https://your-website.onrender.com
WEBSITE_INTERNAL_TOKEN=replace-with-a-32-char-secret